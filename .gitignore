# for this project
.gitvenv/

lcov.info

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
# pi coding-agent state (local harness settings, not part of the project)
.agent/

# Test scaffolding: fixture repositories and the isolated database cache
# built by tests/common (see tests/*/fixtures, tests/*/cache)
tests/*/fixtures/
tests/*/cache/

# Generated by the fixture builders in tests/common: manifests, the lockfiles they
# resolve, and the stdio captured by run_captured. A passing run removes the
# manifests and lockfiles; leftovers from a failed run stay out of git anyway.
tests/*/dependencies.yaml
!tests/manifest/dependencies.yaml
tests/*/gipm.lock
tests/*/out.txt
tests/*/err.txt
tests/*/dependencies-probe.yaml

# Coverage run outputs (cargo llvm-cov)
cov.json
cov.lcov
cov-*.lcov
